# Copiar a .env y ajustar. Nunca subir .env al repo.
PORT=3000
DATA_DIR=./data
SESSION_TTL_HOURS=12
# Contraseña bootstrap para los 7 usuarios semilla (se obliga a cambiarla al entrar).
# Cámbiala aquí antes del primer arranque en producción.
SEED_PASSWORD=Cambiar123*
COOKIE_SECURE=false

# ---- Paso 3: Supabase (datos + realtime) ----
# Sin estas 3, el backend usa JSON local. Con ellas, usa Supabase.
# La SERVICE key (o sb_secret_*) SOLO vive en servidor/Vercel env. Jamas en frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
