[TEMPLATE]
# Copiar a .env y ajustar. Nunca subir .env al repo.
PORT=3000
DATA_DIR=./data
SESSION_TTL_HOURS=12
# Contraseña bootstrap para los 7 usuarios semilla (se obliga a cambiarla al entrar).
# Cámbiala aquí antes del primer arranque en producción.
SEED_PASSWORD=Cambiar123*
COOKIE_SECURE=false
# Supabase (producción). Sin estas dos, el backend usa JSON local.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Tamaño máximo por archivo subido en MB (Paso 4). Tope de Vercel no aplica:
# los bytes van directo del navegador a Supabase Storage.
MEDIA_MAX_MB=50
# Tope del rate-limit de login (default 10). Los tests lo suben a 100.
LOGIN_RATE_MAX=10

# Reporte Ejecutivo semanal (cron lunes 07:00 CdMx)
# Vercel logea Authorization: Bearer $CRON_SECRET en /api/report/weekly
CRON_SECRET=
# Envío de correo (Resend). Sin RESEND_API_KEY se registra en dry-run (no envía).
RESEND_API_KEY=
MAIL_FROM=Reporte Ejecutivo <alertas@tudominio.com>
# Opcional: sobreescribe los destinatarios (directivos con email en la base)
REPORT_RECIPIENTS=
