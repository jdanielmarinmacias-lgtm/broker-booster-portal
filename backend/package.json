{
  "name": "broker-booster-backend",
  "version": "0.2.0",
  "description": "Backend propio del portal (Paso 2): auth interno, sesiones HttpOnly, API por roles. Sin Auth externo.",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "import": "node src/import.js",
    "test": "node --test test/smoke.js test/permissions.js test/rate-limit.js test/guia-context.js test/ia-gateway.js",
    "storage:inventario": "node tools/storage-inventory.js",
    "storage:optimizar": "node tools/optimize-storage.js",
    "uploads:migrar": "node scripts/migrate-uploads.js",
    "db:backup": "node scripts/backup.js",
    "db:backup:verify": "node scripts/backup.js --verify",
    "db:scrub-keys": "node scripts/scrub-keys.js",
    "ia:gateway": "python gateway/serve_gateway.py"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "express": "^4.21.2",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
